<% enrollments ||= [] %>
<%= render 'components/collapsible', heading: 'Hành Trình Thiêng Liêng' do %>
  <% enrollments ||= [] %>
  <% enrollments.each do |enrollment| %>
    <%= render 'enrollments/detail', enrollment: enrollment, editable: policy(enrollment).update? %>
  <% end %>
  <%= render('enrollments/new') if @student %>
<% end unless enrollments.empty? && !@student %>